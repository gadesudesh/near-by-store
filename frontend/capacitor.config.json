{
  "appId": "com.sudesh.nearbystore",
  "appName": "Near By Store",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    },
    "Preferences": {}
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
